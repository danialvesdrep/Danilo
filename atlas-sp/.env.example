# ─── Banco de dados ────────────────────────────────────────────────
# PostgreSQL 14+ (Supabase, Neon, RDS ou instância própria)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/atlas_sp?schema=public"

# ─── Aplicação ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Atlas SP"
# Chave de assinatura das sessões. Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres"
# Duração da sessão em dias
AUTH_SESSION_DAYS="30"

# ─── Jobs / ingestão ───────────────────────────────────────────────
# Protege POST /api/cron/[job]. Envie como header: Authorization: Bearer <valor>
CRON_SECRET=""
# Ativa jobs que fazem requisições externas (desligado por padrão)
INGESTION_ENABLED="false"

# ─── Mapas ─────────────────────────────────────────────────────────
# Opcional. Sem token, o mapa usa MapLibre com um estilo vetorial próprio
# construído a partir da malha municipal do IBGE (funciona offline).
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_MAP_STYLE_URL=""

# ─── IA (arquitetura agnóstica de provedor) ────────────────────────
# Provedores: anthropic | openai | grounded-local
# grounded-local não faz chamadas externas: compõe a resposta apenas
# a partir dos fatos recuperados do banco. É o padrão seguro.
AI_PROVIDER="grounded-local"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Teto de perguntas por usuário por dia (0 = usar limite do plano)
AI_DAILY_QUESTION_CAP="0"

# ─── Cobrança (nenhuma cobrança é simulada) ────────────────────────
# Provedores: none | stripe | mercadopago
BILLING_PROVIDER="none"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ─── Cache (opcional) ──────────────────────────────────────────────
REDIS_URL=""

# ─── Busca (Postgres FTS por padrão) ───────────────────────────────
# Provedores futuros: meilisearch | opensearch
SEARCH_PROVIDER="postgres"
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""

# ─── Analytics ─────────────────────────────────────────────────────
ANALYTICS_ENABLED="true"
